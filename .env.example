# ============================================
# Copiar este archivo a ".env" y ajustar valores
# NUNCA subir el .env real a git (ver .gitignore)
# ============================================

# --- Base de datos ---
DB_NAME=verificadora_db
DB_USER=verificadora_user
DB_PASSWORD=cambia_este_password_seguro
DB_PORT_HOST=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=10

# --- Frontend ---
FRONTEND_PORT=4200

# --- Producción (docker-compose.prod.yml) ---
HTTP_PORT=80
API_URL=/api
